{
  "name": "@pl/assets",
  "private": true,
  "version": "0.1.0",
  "description": "Asset bakes: loaner Friends via FriendSDK createFriendReader (public RPC, no wallet) and the voxel Friend gallery screenshot.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./loaners.json": "./out/loaners.json"
  },
  "scripts": {
    "bake:loaners": "tsx src/bake-loaners.ts",
    "gallery": "tsx src/gallery.ts",
    "gallery:shot": "tsx src/gallery.ts --shot",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@pl/shared": "*",
    "@rarefriends/friendsdk": "file:../../vendor/rarefriends-friendsdk-0.1.4.tgz"
  },
  "devDependencies": {
    "@pl/mock-rpc": "*",
    "playwright": "1.63.0",
    "vite": "^8.3.1",
    "prettier": "^3.9.9"
  }
}
