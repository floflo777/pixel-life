# @pl/server local development (copy to apps/server/.env or export in your shell; never commit real values).
# Production values live in deploy/.env (see deploy/.env.example and deploy/README.md).
NODE_ENV=development
HOST=127.0.0.1
PORT=3100
LOG_LEVEL=debug
# e.g. `docker run -d --name pl-dev-pg -e POSTGRES_PASSWORD=dev -p 127.0.0.1:55433:5432 postgres:16-alpine`
DATABASE_URL=postgres://postgres:dev@127.0.0.1:55433/postgres
# Vite dev server origin(s): the SIWE domain must be one of these hosts.
PUBLIC_ORIGINS=http://localhost:5173
# Leave empty locally to disable the origin-key guard (required in production).
ORIGIN_KEY=
# Local cookies over http need COOKIE_SECURE=false.
COOKIE_SECURE=false
SESSION_SECRET=dev-session-secret-at-least-32-bytes!!
DAILY_SECRET=dev-daily-secret-at-least-32-bytes!!!!
# Point at the public RPC, or at `npm start -w @pl/mock-rpc` for offline fixtures.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
ECONOMY_MODE=sim
# Live mode only (not deployed, not audited; see contracts/README.md): sink address and confirmation depth.
# PIXEL_LIFE_SINK=0x...
# LIVE_CONFIRMATIONS=3
# Seed Pack simulated house stake in RF (default 10000) and replay worker threads (default 2, 0 = verification off).
# SEEDPACK_STAKE_RF=10000
# REPLAY_WORKERS=2
# Optional: CHAIN_ID, GENERATIONS_ADDRESS, ROOMS, SESSION_TTL_DAYS, GUEST_TTL_DAYS, DB_POOL_MAX,
# TRUST_EDGE_CLIENT_IP, MIGRATE_ON_START, MIGRATIONS_DIR (see src/config.ts).
