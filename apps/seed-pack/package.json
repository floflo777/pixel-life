{
  "name": "@pl/seed-pack",
  "private": true,
  "version": "0.1.0",
  "description": "Seed Pack Booth: a stock FriendSDK chance game (sandboxed child) for the Pixel Life hub.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "friendsdk dev .",
