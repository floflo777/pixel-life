# nginx vhost for the hidden Pixel Life origin (architecture HOSTING DECISION).
# Render with deploy/nginx/render.sh (substitutes __ORIGIN_KEY__), install as
# /etc/nginx/sites-available/rf-origin.ailog.fr.conf (mode 600, owner root), symlink into sites-enabled,
# then `nginx -t && systemctl reload nginx`. Touches no other vhost.
#
# Accepts only: Host rf-origin.ailog.fr, Cloudflare source IPs, a valid x-pl-origin-key, paths /api/ and /ws/.
# The Node server re-checks the key itself (defence in depth).

# Upgrade/Connection pass-through for WebSockets.
map $http_upgrade $pl_connection_upgrade {
    default upgrade;
    ""      close;
}

upstream pixel_life_server {
    server 127.0.0.1:3100;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name rf-origin.ailog.fr;
    # Cloudflare connects over HTTPS (SSL mode Full (strict)); plain HTTP is never served.
    return 444;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name rf-origin.ailog.fr;

    # Cloudflare Origin Certificate (15-year, trusted by Cloudflare only) or Let's Encrypt.
    ssl_certificate     /etc/ssl/cloudflare/rf-origin.ailog.fr.pem;
    ssl_certificate_key /etc/ssl/cloudflare/rf-origin.ailog.fr.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    # Optional, stronger: require Cloudflare Authenticated Origin Pulls.
    # ssl_client_certificate /etc/ssl/cloudflare/authenticated_origin_pull_ca.pem;
    # ssl_verify_client on;

    # Only Cloudflare edges may connect (list refreshed by update-cloudflare-ips.sh).
    include /etc/nginx/snippets/cloudflare-allow.conf;
    deny all;

    access_log /var/log/nginx/rf-origin.access.log;
    error_log  /var/log/nginx/rf-origin.error.log warn;

    client_max_body_size 64k;
    server_tokens off;

    # Shared secret from the edge Worker. A plain string compare (a map would need a bigger map_hash_bucket_size,
    # which is an http-level setting shared with the other vhosts on this host).
    if ($http_x_pl_origin_key != "__ORIGIN_KEY__") {
        return 403;
    }

    location /api/ {
        proxy_pass http://pixel_life_server;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # x-pl-origin-key, x-pl-client-ip and x-request-id from the Worker pass through unchanged.
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        proxy_buffering on;
    }

    location /ws/ {
        proxy_pass http://pixel_life_server;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $pl_connection_upgrade;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        # The server pings every 30 s; idle hub sockets stay open up to an hour.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # Health endpoints and everything else stay private to the host.
    location / {
        return 404;
    }
}
