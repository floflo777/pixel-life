# nginx vhost for the hidden Pixel Life origin (architecture HOSTING DECISION).
# Rendered by deploy/nginx/render.sh (substitutes __ORIGIN_HOST__, __ORIGIN_KEY__, __SSL_CERT__, __SSL_KEY__) and
# installed by scripts/deploy.sh as /etc/nginx/sites-available/<host>.conf (mode 600, owner root), symlinked into
# sites-enabled, then `nginx -t && systemctl reload nginx`. Touches no other vhost. Written for nginx 1.18 (ailog).
#
# Accepts only: Host __ORIGIN_HOST__, Cloudflare source IPs (plus loopback for on-host smoke tests), a valid
# x-pl-origin-key, paths /api/, /ws/ and the health aliases. The Node server re-checks the key (defence in depth).

# Upgrade/Connection pass-through for WebSockets. Names are prefixed so they cannot clash with other vhosts.
map $http_upgrade $pl_connection_upgrade {
    default upgrade;
    ""      close;
}

upstream pixel_life_server {
    server 127.0.0.1:3100;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name __ORIGIN_HOST__;
    server_tokens off;

    # Let's Encrypt HTTP-01 (certbot --webroot). Nothing else is served over plain HTTP.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/pixel-life-acme;
        default_type text/plain;
    }
    location / {
        return 444;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __ORIGIN_HOST__;

    ssl_certificate     __SSL_CERT__;
    ssl_certificate_key __SSL_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    # Optional, stronger (proxied hostname only): require Cloudflare Authenticated Origin Pulls.
    # ssl_client_certificate /etc/ssl/cloudflare/authenticated_origin_pull_ca.pem;
    # ssl_verify_client on;

    # Only Cloudflare edges (the Worker's subrequests) may connect; loopback for on-host smoke tests.
    allow 127.0.0.1;
    allow ::1;
    include /etc/nginx/snippets/pixel-life-cloudflare-allow.conf;
    deny all;

    access_log /var/log/nginx/pixel-life-origin.access.log;
    error_log  /var/log/nginx/pixel-life-origin.error.log warn;

    client_max_body_size 64k;
    client_body_timeout 10s;
    client_header_timeout 10s;
    server_tokens off;

    # Shared secret from the edge Worker. A plain string compare (a map would need a bigger map_hash_bucket_size,
    # which is an http-level setting shared with the other vhosts on this host).
    if ($http_x_pl_origin_key != "__ORIGIN_KEY__") {
        return 403;
    }

    # Health aliases behind the key: /api/health and /health → /healthz, /api/ready and /ready → /readyz.
    location = /api/health { proxy_pass http://pixel_life_server/healthz; proxy_set_header Connection ""; proxy_http_version 1.1; }
    location = /health     { proxy_pass http://pixel_life_server/healthz; proxy_set_header Connection ""; proxy_http_version 1.1; }
    location = /api/ready  { proxy_pass http://pixel_life_server/readyz;  proxy_set_header Connection ""; proxy_http_version 1.1; }
    location = /ready      { proxy_pass http://pixel_life_server/readyz;  proxy_set_header Connection ""; proxy_http_version 1.1; }

    location /api/ {
        proxy_pass http://pixel_life_server;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # x-pl-origin-key, x-pl-client-ip and x-request-id from the Worker pass through unchanged.
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        proxy_buffering on;
    }

    location /ws/ {
        proxy_pass http://pixel_life_server;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $pl_connection_upgrade;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        # The server pings every 30 s; idle hub sockets stay open up to an hour.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # /healthz, /readyz and everything else stay private to the host.
    location / {
        return 404;
    }
}
