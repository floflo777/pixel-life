# Pixel Life server: docker compose environment (copy to deploy/.env, chmod 600, never commit).
# Generate every secret with: openssl rand -hex 32   (hex keeps them URL-safe)

# ── PostgreSQL (container "postgres", published on 127.0.0.1:55432 for admin access only) ──
POSTGRES_DB=pixel_life
POSTGRES_USER=pixel_life
POSTGRES_PASSWORD=change-me-hex-32

# ── Server ──
# Browser origins allowed to call the API and sign in (comma-separated; first is canonical).
# Keep in sync with the Worker's public hostname (it may be renamed, e.g. to *.floflo777.workers.dev).
PUBLIC_ORIGINS=https://pixel-life.florent-g.workers.dev
# Shared secret the edge Worker sends as x-pl-origin-key (same value: `wrangler secret put ORIGIN_KEY`, and nginx).
ORIGIN_KEY=change-me-hex-32
# HS256 key for pl_sess / pl_guest cookies. Rotating it logs everyone out.
SESSION_SECRET=change-me-hex-32
# HMAC key for daily run seeds. Rotating it changes today's seed: only rotate between days.
DAILY_SECRET=change-me-hex-32
# Robinhood Chain RPC used for fresh-block eligibility and EIP-1271 signature checks.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
# sim (default, labelled SIMULATED) | live (only after contracts are reviewed and deployed with owner authorization)
ECONOMY_MODE=sim
LOG_LEVEL=info
# Optional (defaults shown):
# CHAIN_ID=4663
# GENERATIONS_ADDRESS=0x14C49e6118F46525dE9ab41a51cBAA3c6EBF181D
# SESSION_TTL_DAYS=7
# GUEST_TTL_DAYS=30
# DB_POOL_MAX=10
# TRUST_EDGE_CLIENT_IP=true
# MIGRATE_ON_START=true
